[Unit]
Description=Pantau Dashboard Server (FastAPI + Uvicorn)
Wants=network-online.target
After=network-online.target mysql.service mariadb.service

[Service]
Type=simple
User=pantau-server
Group=pantau-server
WorkingDirectory=/opt/pantau/server
Environment=HOME=/opt/pantau/server
ExecStart=/opt/pantau/server/env/bin/uvicorn main:app --host 0.0.0.0 --port 8400
Restart=always
RestartSec=3
StartLimitIntervalSec=0
Nice=0

StandardOutput=journal
StandardError=journal

# Sandbox ringan -- dashboard membaca templates/static, menulis /tmp, dan
# terhubung ke MySQL (jaringan).
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes

[Install]
WantedBy=multi-user.target