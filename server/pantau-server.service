[Unit]
Description=Pantau Dashboard Server (FastAPI + Uvicorn)
Wants=network-online.target
After=network-online.target mysql.service mariadb.service
# tanpa batas laju restart: dashboard segera pulih bila crash sesaat
StartLimitIntervalSec=0

[Service]
Type=simple
User=pantau-server
Group=pantau-server
WorkingDirectory=/opt/pantau/server
Environment=HOME=/opt/pantau/server
Environment=SERVER_PORT=8400
EnvironmentFile=/opt/pantau/server/.env
# --port memakai SERVER_PORT dari .env (bila ada); fallback 8400 di atas.
ExecStart=/opt/pantau/server/env/bin/uvicorn main:app --host 0.0.0.0 --port ${SERVER_PORT}
Restart=always
RestartSec=3
Nice=0

StandardOutput=journal
StandardError=journal

# Sandbox ringan -- dashboard membaca templates/static, menulis /tmp, dan
# terhubung ke MySQL (jaringan).
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes

[Install]
WantedBy=multi-user.target