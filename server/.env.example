# Konfigurasi Basis Data MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=monitor_user
DB_PASS=CHANGE_ME_STRONG_PASSWORD
DB_NAME=server_monitor

# Konfigurasi Host & Port Server Backend
SERVER_HOST=0.0.0.0
SERVER_PORT=8400

# Kunci Rahasia Sesi & CSRF (Generate: python3 -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=isi_kunci_rahasia_32_byte_hex_disini

# Keamanan Cookie (Setel True jika diakses lewat HTTPS reverse proxy)
SESSION_COOKIE_SECURE=False

# IP Proxy Terpercaya untuk membaca X-Forwarded-For (pisahkan koma)
TRUSTED_PROXY_IPS=127.0.0.1,::1

# File Log Uvicorn
LOG_FILE=/tmp/uvicorn-pantau.log
