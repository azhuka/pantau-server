# Pantau Server Environment Configuration Example
SERVER_HOST=0.0.0.0
SERVER_PORT=8401
SECRET_KEY=change_this_to_a_secure_random_string_in_production

# Database Configuration (Clean Slate Persistence)
# MySQL / MariaDB (e.g. mysql+pymysql://user:pass@127.0.0.1:3306/pantau_v2)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=pantau_user
DB_PASS=pantau_password
DB_NAME=pantau_clean_db
