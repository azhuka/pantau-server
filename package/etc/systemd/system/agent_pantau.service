[Unit]
Description=Pantau Monitoring Agent (agent_pantau)
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=pantau
Group=pantau
ExecStartPre=+-/bin/sh -c 'if [ ! -f /opt/pantau/agent/agent_pantau.py ] || ! /usr/bin/python3 /opt/pantau/agent/agent_pantau.py --test-runtime >/dev/null 2>&1; then found_bak=""; for b in /opt/pantau/agent/agent_pantau.py.bak $(ls -t /opt/pantau/agent/agent_pantau.py.bak.* 2>/dev/null); do if [ -f "$b" ] && /usr/bin/python3 "$b" --test-runtime >/dev/null 2>&1; then found_bak="$b"; break; fi; done; if [ -n "$found_bak" ]; then logger -t agent_pantau "Auto-rollback: file utama rusak/hilang, memulihkan dari cadangan $found_bak"; cp -f "$found_bak" /opt/pantau/agent/agent_pantau.py && chmod 755 /opt/pantau/agent/agent_pantau.py; fi; fi'
ExecStart=/opt/pantau/agent/agent_pantau.py
Restart=always
RestartSec=5
Nice=5
StandardOutput=journal
StandardError=journal

# CATATAN ARSITEKTUR KEAMANAN:
# Isolasi mount namespace (PrivateTmp, ProtectSystem, ProtectKernel*, dll.) sengaja tidak digunakan.
# Sesuai standar Linux & systemd, direktif tersebut secara otomatis memaksa kernel menyematkan flag
# PR_SET_NO_NEW_PRIVS pada Linux Container (LXC/Proxmox CT unprivileged), yang akan memblokir eskalasi
# sudo oleh biner wrapper. Keamanan agen sepenuhnya dijamin oleh isolasi user 'pantau' (tanpa shell login)
# dan pembatasan ketat whitelist perintah pada /etc/sudoers.d/pantau-agent.

[Install]
WantedBy=multi-user.target