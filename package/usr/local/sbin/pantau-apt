#!/bin/sh
# pantau-apt — Cangkang sempit utk tombol Update/Upgrade paket OS.
# Dipanggil agen 'pantau' via sudo NOPASSWD (lihat /etc/sudoers.d/pantau-agent).
# Dijalankan lewat pty (script -qfc) supaya output PERSIS seperti terminal SSH:
# baris progress \r ikut terlihat, dan dpkg bisa BERINTERAKSI lewat stdin.
# Argumen divalidasi di sini; BUKAN shell passthrough. URL/repo tetap apa adanya.
#
# Pemakaian:
#   pantau-apt update            -> sinkron, non-interaktif
#   pantau-apt upgrade           -> upgrade NON-INTERAKTIF (aman, tak menggantung)
#   pantau-apt upgrade-interact  -> upgrade INTERAKTIF: admin mengetik jawaban
#                                   sendiri lewat kotak input di Dashboard
#                                   (dpkg boleh bertanya apa pun)
#
# Kenapa ada dua mode? Non-interaktif cocok untuk update terjadwal/massal.
# Interaktif dipakai admin yang ingin memutuskan sendiri tiap prompt dpkg
# (mis. memakai konfigurasi bawaan paket, bukan miliknya).
set -e

DPKG_KEEP_LOCAL="-o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold"
DPKG_COMMON="-o Dpkg::Use-Pty=0 -o Dpkg::Lock::Timeout=600"

# Tolak jalan bila proses apt/dpkg lain sedang memegang lock, alih-alih
# menunggu lalu gagal setengah jalan. Lock depan = dpkg sedang mengubah paket.
if [ -e /var/lib/dpkg/lock-frontend ] && fuser /var/lib/dpkg/lock-frontend >/dev/null 2>&1; then
    echo "pantau-apt: proses apt/dpkg lain sedang berjalan (lock /var/lib/dpkg/lock-frontend dipegang)." >&2
    echo "           Tunggu proses itu selesai, lalu ulangi. Tidak ada yang dirusak." >&2
    exit 3
fi

case "${1:-}" in
    update)
        # Sinkron daftar paket: aman non-interaktif, tanpa bisa menggantung.
        export DEBIAN_FRONTEND=noninteractive
        export NEEDRESTART_MODE=l
        export APT_LISTCHANGES_FRONTEND=none
        exec /usr/bin/script -qfc "/usr/bin/apt-get update -o Dpkg::Lock::Timeout=600" /dev/null
        ;;
    upgrade)
        # Tanpa prompt: konfigurasi lokal admin dipertahankan, konfigurasi baru
        # memakai bawaan paket; needrestart merestart diam-diam.
        export DEBIAN_FRONTEND=noninteractive
        export NEEDRESTART_MODE=a
        export APT_LISTCHANGES_FRONTEND=none
        exec /usr/bin/script -qfc "/usr/bin/apt-get -y -o Dpkg::Lock::Timeout=600 $DPKG_KEEP_LOCAL $DPKG_COMMON upgrade" /dev/null
        ;;
    upgrade-interact)
        # Tanpa --force-confold & tanpa DEBIAN_FRONTEND=noninteractive, sehingga
        # dpkg benar-benar BERHENTI dan bertanya; jawabannya datang dari admin
        # melalui stdin proses (dikirim agen dari kotak input Dashboard).
        unset DEBIAN_FRONTEND DEBCONF_NONINTERACTIVE_SEEN
        export NEEDRESTART_MODE=a
        export APT_LISTCHANGES_FRONTEND=none
        # -o Dpkg::Use-Pty=1: dpkg menulis prompt ke pty sehingga kelihatan di UI.
        echo "== MODE INTERAKTIF =="
        echo "Jawab setiap pertanyaan yang muncul di kotak terminal bawah."
        echo "Membatalkan:   Ctrl+C di server, atau tombol Hentikan di Dashboard."
        echo
        exec /usr/bin/script -qfc "/usr/bin/apt-get -y -o Dpkg::Lock::Timeout=600 -o Dpkg::Use-Pty=1 upgrade" /dev/null
        ;;
    fix)
        # Mode reparasi: pulihkan dpkg yang terinterupsi & perbaiki dependensi rusak
        unset DEBIAN_FRONTEND DEBCONF_NONINTERACTIVE_SEEN
        export NEEDRESTART_MODE=a
        export APT_LISTCHANGES_FRONTEND=none
        echo "== MEMULIHKAN PAKET SISTEM (REPARASI DPKG & DEPENDENSI) =="
        echo "[1/2] Menjalankan: dpkg --configure -a ..."
        /usr/bin/script -qfc "/usr/bin/dpkg --configure -a" /dev/null || true
        echo
        echo "[2/2] Memperbaiki dependensi paket: apt-get -f install ..."
        exec /usr/bin/script -qfc "/usr/bin/apt-get -y -f -o Dpkg::Lock::Timeout=600 -o Dpkg::Use-Pty=1 install" /dev/null
        ;;
    *)
        echo "pantau-apt: argumen tidak dikenal: '${1:-}'" >&2
        echo "            (hanya: update | upgrade | upgrade-interact | fix)" >&2
        exit 2
        ;;
esac