#!/usr/bin/env bash
#
# pantau-restart - Wrapper restart/start/stop service untuk Agen Pantau.
#
# Alasan wrapper ini ada:
#   - Menyediakan jalur sudo NOPASSWD yang SEMPIT (bukan "systemctl *")
#   - Memvalidasi argumen (tanpa shell passthrough / wildcard)
#   - Menolak unit kritis infrastruktur lewat deny-list
#
# Penggunaan (hanya dipanggil agent):
#   pantau-restart restart|start|stop <unit>
#
# Unit adalah nama service yang dinormalisasi agent (mis. sshd, mysql, uvicorn).
# Attempt: systemctl <action> <unit> yang mengikuti deny-list & alias mapping.
#
set -u

ACTION="${1:-}"
UNIT="${2:-}"
DENY_FILE="/etc/pantau/restart.deny"

# Alias umum nama process -> unit systemd
alias_unit() {
    local name="$1"
    case "$name" in
        mysql|mysqld|mariadbd|mariadb) printf 'mariadb' ;;
        ssh|sshd)                      printf 'ssh' ;;
        zabbix_agent2|zabbix-agent2)   printf 'zabbix-agent2' ;;
        zabbix_agent|zabbix-agent)     printf 'zabbix-agent' ;;
        smtpd|master|postfix)          printf 'postfix' ;;
        cron|crond)                    printf 'cron' ;;
        *)                             printf '%s' "${name//_/-}" ;;
    esac
}

fail() {
    echo "$*" >&2
    exit 1
}

# --- Validasi aksi ---
case "$ACTION" in
    restart|start|stop) ;;
    *) fail "Aksi tidak dikenal: '${ACTION}' (harus restart/start/stop)" ;;
esac

# --- Sanitasi nama unit: hanya karakter aman, panjang wajar ---
[ -n "$UNIT" ] || fail "Nama unit kosong"
[ "${#UNIT}" -le 64 ] || fail "Nama unit terlalu panjang"
case "$UNIT" in
    *[!a-zA-Z0-9@._-]*) fail "Nama unit mengandung karakter tidak valid: '$UNIT'" ;;
esac

# --- Deny-list (prefix match) ---
[ -r "$DENY_FILE" ] || fail "File deny-list tidak terbaca: $DENY_FILE"
while IFS= read -r pat; do
    pat="${pat%%#*}"          # buang komentar
    [ -z "$pat" ] && continue
    pat="${pat// /}"          # buang spasi
    [ -z "$pat" ] && continue
    case "$UNIT" in
        "${pat}"*) fail "Unit '$UNIT' masuk deny-list (pola '$pat'), ditolak." ;;
    esac
done < "$DENY_FILE"

# --- Eksekusi: coba unit asli, lalu alias, lalu nama dengan hyphen ---
ERR=""
run_unit() {
    local unit="$1" out rc
    [ -z "$unit" ] && return 1
    out="$(/usr/bin/systemctl "$ACTION" "$unit" 2>&1)"
    rc=$?
    # Jangan tampilkan error percobaan gagal bila nanti ada yang berhasil
    if [ $rc -ne 0 ]; then
        ERR="${ERR}${out}"$'\n'
    fi
    return $rc
}

# Eksekusi unit dan soket pendamping jika ada (misal ssh.socket untuk ssh.service)
run_unit_with_socket() {
    local target="$1"
    local base="${target%.service}"
    base="${base%.socket}"

    if [ "$ACTION" = "stop" ]; then
        local stopped_any=0
        # Cek dan stop unit service
        if /usr/bin/systemctl is-active --quiet "${base}.service" 2>/dev/null; then
            run_unit "${base}.service" && stopped_any=1
        elif run_unit "$target"; then
            stopped_any=1
        fi
        # Cek dan stop unit socket pendamping
        if /usr/bin/systemctl is-active --quiet "${base}.socket" 2>/dev/null || /usr/bin/systemctl list-unit-files "${base}.socket" 2>/dev/null | grep -q "${base}.socket"; then
            run_unit "${base}.socket" && stopped_any=1
        fi
        [ "$stopped_any" -eq 1 ] && return 0
        return 1
    elif [ "$ACTION" = "start" ] || [ "$ACTION" = "restart" ]; then
        local ok=0
        # Jika ada socket, start socket juga jika perlu
        if /usr/bin/systemctl list-unit-files "${base}.socket" 2>/dev/null | grep -q "${base}.socket"; then
            /usr/bin/systemctl "$ACTION" "${base}.socket" 2>/dev/null || true
        fi
        if run_unit "${base}.service"; then
            ok=1
        elif run_unit "$target"; then
            ok=1
        fi
        [ "$ok" -eq 1 ] && return 0
        return 1
    else
        run_unit "$target"
    fi
}

if run_unit_with_socket "$UNIT"; then
    echo "OK: systemctl $ACTION $UNIT"
    exit 0
fi

ALIAS="$(alias_unit "$UNIT")"
if [ "$ALIAS" != "$UNIT" ]; then
    if run_unit_with_socket "$ALIAS"; then
        echo "OK: systemctl $ACTION $UNIT (resolved -> $ALIAS)"
        exit 0
    fi
fi

HYPHEN_UNIT="${UNIT//_/-}"
if [ "$HYPHEN_UNIT" != "$UNIT" ] && [ "$HYPHEN_UNIT" != "$ALIAS" ]; then
    if run_unit_with_socket "$HYPHEN_UNIT"; then
        echo "OK: systemctl $ACTION $UNIT (resolved -> $HYPHEN_UNIT)"
        exit 0
    fi
fi


# --- Jika aksi adalah 'stop' dan systemctl service gagal, coba hentikan scope atau proses mandiri ---
if [ "$ACTION" = "stop" ]; then
    # 1. Coba cari systemd scope (mis. app-com.google.Chrome-*.scope)
    SCOPES="$(/usr/bin/systemctl list-units --type=scope --state=running --no-legend "*${UNIT}*" 2>/dev/null | awk '{print $1}' || true)"
    if [ -n "$SCOPES" ]; then
        for sc in $SCOPES; do
            /usr/bin/systemctl stop "$sc" 2>/dev/null || true
        done
        echo "OK: systemctl stop scope $SCOPES"
        exit 0
    fi

    # 2. Coba cari PID proses langsung yang cocok dengan nama unit
    PIDS="$(pgrep -x "$UNIT" 2>/dev/null || true)"
    if [ -z "$PIDS" ]; then
        PIDS="$(pidof "$UNIT" 2>/dev/null || true)"
    fi
    if [ -n "$PIDS" ]; then
        kill -TERM $PIDS 2>/dev/null || true
        sleep 1
        REMAINING="$(pgrep -x "$UNIT" 2>/dev/null || true)"
        if [ -n "$REMAINING" ]; then
            kill -KILL $REMAINING 2>/dev/null || true
        fi
        echo "OK: proses $UNIT berhasil dihentikan (PIDs: $PIDS)"
        exit 0
    fi
fi

printf '%s' "$ERR" >&2
fail "systemctl $ACTION $UNIT gagal"